# Copy this file to your private env location, for example:
# C:\Users\<you>\secrets\ai-trading-gold\.env
#
# Do not commit real values. config/settings.py loads env files in this order:
# 1. GOLD_ENV_PATH
# 2. C:\Users\<you>\secrets\ai-trading-gold\.env
# 3. .env in the project root

# Broker / Capital.com
CAPITAL_EMAIL=your-email@example.com
CAPITAL_PASSWORD=replace-with-your-password
CAPITAL_API_KEY=replace-with-your-api-key
CAPITAL_DEMO=true

# Database
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gold_trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=replace-with-a-local-password
SQLITE_FALLBACK=true
SQL_ECHO=false

# Trading safety defaults
TRADING_MODE=semi_auto
TRADING_INTERVAL_SECONDS=60
POSITION_CHECK_SECONDS=30
MIN_CONFIDENCE=0.55
MIN_TRADE_SCORE=60
CONFIRMATION_TIMEOUT_SECONDS=120
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_WEEKLY_LOSS_PCT=10.0
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=5
KILL_SWITCH_DRAWDOWN_PCT=20.0
MAX_CONSECUTIVE_LOSSES=5
COOLDOWN_MINUTES=30
MAX_SPREAD_PIPS=3.0
TRADING_START_HOUR=8
TRADING_START_MINUTE=0
TRADING_END_HOUR=22
TRADING_END_MINUTE=0

# Local API
API_ENABLED=true
API_HOST=127.0.0.1
API_PORT=8000
API_AUTH_ENABLED=true
API_KEY=replace-with-a-long-random-local-key
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173

# UI demo / Gemini
GEMINI_API_KEY=
UI_DEMO_GEMINI_MODEL=gemini-flash-latest
UI_DEMO_LLM_ENABLED=true
UI_DEMO_REPORT_PATH=logs/ui_demo/KI_ANALYSE_REPORT.txt

# Notifications
NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Monitoring
TRADER_URL=http://localhost:8000
CHECK_INTERVAL=30
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
REDIS_URL=redis://localhost:6379/0
MAX_LATENCY_MS=100
DISK_CHECK_PATH=

# Optional features
MIROFISH_ENABLED=false
MIROFISH_URL=http://localhost:5001
ZEP_API_KEY=
CALENDAR_ENABLED=true
SENTIMENT_ENABLED=false
CORRELATION_ENABLED=false
EXIT_AI_ENABLED=false
EXIT_AI_SAVED_MODELS_DIR=ai_engine/saved_models
ORDERFLOW_ENABLED=false
ORDERFLOW_QUOTE_ENRICHMENT_ENABLED=false

# GoldBot control app
CONTROL_APP_ACCESS_TOKEN=replace-with-a-long-random-local-token
CONTROL_APP_API_HOST=127.0.0.1
CONTROL_APP_API_PORT=8060
CONTROL_APP_RETENTION_DAYS=30
CONTROL_APP_DB_PATH=
CONTROL_APP_SOURCE_DB_PATH=
